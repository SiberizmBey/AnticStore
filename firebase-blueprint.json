{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User preferences and cryptographic salt for Koza vault",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "vaultSalt": { "type": "string" },
        "vaultVerifier": { "type": "string" },
        "theme": { "type": "string" },
        "accent": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "vaultSalt", "vaultVerifier", "createdAt", "updatedAt"]
    },
    "AccountItem": {
      "title": "AccountItem",
      "description": "Registered account with encrypted recovery credentials and metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "serviceName": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 50 },
        "accountIdentifier": { "type": "string", "maxLength": 200 },
        "identifierType": { "type": "string", "enum": ["email", "username", "phone"] },
        "serviceUrl": { "type": "string", "maxLength": 300 },
        "icon": { "type": "string", "maxLength": 50 },
        "encryptedData": { "type": "string", "maxLength": 20000 },
        "iv": { "type": "string", "maxLength": 64 },
        "recoveryEmailHint": { "type": "string", "maxLength": 200 },
        "recoveryPhoneHint": { "type": "string", "maxLength": 50 },
        "hasRecoveryCodes": { "type": "boolean" },
        "recoveryCodesCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "serviceName", "category", "accountIdentifier", "identifierType", "encryptedData", "iv", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user vault master salt and preferences"
    },
    "/users/{userId}/accounts/{accountId}": {
      "schema": "AccountItem",
      "description": "Stores user encrypted account and recovery information"
    }
  }
}
