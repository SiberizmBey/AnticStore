rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User profile validation
    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
        data.userId is string &&
        data.vaultSalt is string && data.vaultSalt.size() <= 128 &&
        data.vaultVerifier is string && data.vaultVerifier.size() <= 512 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
        (!('theme' in data) || (data.theme in ['amoled', 'dark', 'light'])) &&
        (!('accent' in data) || (data.accent in ['purple', 'indigo', 'emerald', 'blue', 'rose', 'amber', 'cyan', 'zinc'])) &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    // New account documents contain no plaintext account metadata.
    function isValidAccountItem(data, userId, accountId) {
      return data.keys().hasOnly([
          'id',
          'userId',
          'schemaVersion',
          'cryptoVersion',
          'encryptedData',
          'iv',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasAll([
          'id',
          'userId',
          'schemaVersion',
          'cryptoVersion',
          'encryptedData',
          'iv',
          'createdAt',
          'updatedAt'
        ]) &&
        data.userId == userId &&
        data.id == accountId &&
        isValidId(data.id) &&
        data.schemaVersion == 2 &&
        data.cryptoVersion == 1 &&
        data.encryptedData is string && data.encryptedData.size() > 0 && data.encryptedData.size() <= 20000 &&
        data.iv is string && data.iv.matches('^[A-Za-z0-9+/]{16}$') &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Users cannot list other users

      allow create, update: if isOwner(userId) &&
        isValidUserProfile(incoming(), userId);

      allow delete: if isOwner(userId);

      // Subcollection for accounts
      match /accounts/{accountId} {
        allow get, list: if isOwner(userId);

        allow create, update: if isOwner(userId) &&
          isValidAccountItem(incoming(), userId, accountId);

        allow delete: if isOwner(userId);
      }
    }
  }
}
