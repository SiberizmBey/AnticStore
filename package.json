{
    "name": "koru",
    "author": "Antic Valley",
    "private": true,
    "version": "26.1.9-rc.1",
    "type": "module",
    "main": "desktop/main.cjs",
    "scripts": {
        "dev": "tsx server.ts",
        "start": "node server.ts",
        "build": "vite build",
        "preview": "vite preview",
        "clean": "node -e \"for (const path of ['dist', 'release', 'server.js']) require('node:fs').rmSync(path, { recursive: true, force: true })\"",
        "electron:dev": "concurrently -k \"tsx server.ts\" \"wait-on http://127.0.0.1:3000 && electron .\"",
        "electron:build": "npm run build && electron-builder",
        "electron:build:win": "npm run build && electron-builder --win",
        "lint": "tsc --noEmit"
    },
    "build": {
        "appId": "com.anticvalley.koru",
        "productName": "Koru",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "desktop/**/*",
            "package.json"
        ],
        "win": {
            "target": "nsis",
            "icon": "public/assets/img/icon.ico"
        },
        "linux": {
            "target": "AppImage",
            "category": "Utility",
            "icon": "public/assets/img/icon.png"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "runAfterFinish": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Koru"
        }
    },
    "dependencies": {
        "@google/genai": "^2.4.0",
        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-react": "^6.1.1",
        "dotenv": "^17.2.3",
        "express": "^4.21.2",
        "firebase": "^13.1.0",
        "lucide-react": "^0.546.0",
        "motion": "^12.23.24",
        "react": "^19.0.1",
        "react-dom": "^19.0.1",
        "vite": "^8.3.0"
    },
    "devDependencies": {
        "concurrently": "^9.2.1",
        "electron": "^39.2.7",
        "electron-builder": "^26.0.12",
        "@types/node": "^22.14.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "autoprefixer": "^10.4.21",
        "esbuild": "^0.28.0",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.21.0",
        "typescript": "^7.0.2",
        "@types/express": "^4.17.21",
        "wait-on": "^8.0.4",
        "@firebase/rules-unit-testing": "^6.0.0"
    }
}
